    </worldbody>


    <!--
        Couple the two physical finger joints.

        The two bodies use mirrored initial orientations, so the same
        MuJoCo joint coordinate produces mirrored physical motion.
        This is the MJCF equivalent of the official P-Grip 2F mimic
        relation (the right finger mirrors the actuated finger).

        In this exported geometry, q = 0 is the open-side limit and
        negative q closes the fingers. The magnitude of the official
        P-Grip 2F range is 0..30 degrees, therefore the equivalent
        MJCF range here is -30..0 degrees.
    -->
    <equality>
        <joint joint1="gripper_right"
               joint2="gripper_left"
               polycoef="0 1 0 0 0" />
    </equality>


    <!--
        Only ONE actuator is needed.

        The left finger follows the right finger through
        the equality constraint.
    -->
    <actuator>

        <position name="gripper_right_motor"
                  joint="gripper_right"
                  kp="3"
                  ctrlrange="-0.523599 0.0"
                  ctrllimited="true"
                  forcelimited="true"
                  forcerange="-5.44164 5.44164" />

    </actuator>


    <sensor>

        <force name="force_ee"
               site="ft_frame" />

        <torque name="torque_ee"
                site="ft_frame" />

        <rangefinder name="gripper_middle_distance_sensor"
                     site="gripper_middle_range_site" />

        <rangefinder name="right_finger_sensor_0"
                     site="right_finger_sensor_0" />

        <rangefinder name="right_finger_sensor_1"

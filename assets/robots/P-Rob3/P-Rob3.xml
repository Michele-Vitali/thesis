<mujoco model="P-Rob3">
  <option iterations="50" timestep="0.001" solver="PGS" gravity="0 0 -9.81" />

  <compiler angle="radian" meshdir="meshes" eulerseq="zyx" autolimits="true" />

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01" />
    <geom condim="4" contype="1" conaffinity="15" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
  </default>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".0 .0 .0" rgb2=".8 .8 .8" width="100" height="100" />
    <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />

    <mesh name="base_link_1" file="./meshes/base_link_1.obj" />
    <mesh name="base_link_2" file="./meshes/base_link_2.obj" />
    <mesh name="base_link_3" file="./meshes/base_link_3.obj" />
    <mesh name="base_link_screw" file="./meshes/screw.obj" />
    <mesh name="link_1_2_0" file="./meshes/link_1_2_0.obj" />
    <mesh name="link_1_2_1" file="./meshes/link_1_2_1.obj" />
    <mesh name="link_1_2_2" file="./meshes/link_1_2_2.obj" />
    <mesh name="link_1_2_3" file="./meshes/link_1_2_3.obj" />
    <mesh name="link_2_3_1" file="./meshes/link_2_3_1.obj" />
    <mesh name="link_2_3_2" file="./meshes/link_2_3_2.obj" />
    <mesh name="link_3_4_0" file="./meshes/link_3_4_0.obj" />
    <mesh name="link_3_4_1" file="./meshes/link_3_4_1.obj" />
    <mesh name="link_3_4_2" file="./meshes/link_3_4_2.obj" />
    <mesh name="link_3_4_3" file="./meshes/link_3_4_3.obj" />
    <mesh name="link_4_5_1" file="./meshes/link_4_5_1.obj" />
    <mesh name="link_4_5_2" file="./meshes/link_4_5_2.obj" />
    <mesh name="link_5_6_0" file="./meshes/link_5_6_0.obj" />
    <mesh name="link_5_6_1" file="./meshes/link_5_6_1.obj" />
    <mesh name="link_5_6_2" file="./meshes/link_5_6_2.obj" />
    <mesh name="link_6_top_0" file="./meshes/link_6_top_0.obj" />
    <mesh name="grip_link_0" file="./meshes/grip_link_0.obj" />
    <mesh name="grip_link_1" file="./meshes/grip_link_1.obj" />
    <mesh name="grip_link_2" file="./meshes/grip_link_2.obj" />
    <mesh name="finger" file="./meshes/finger.obj" />
    <mesh name="finger_connector_shape" file="./meshes/finger_connector_shape.obj" />
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <geom name="ground" type="plane" pos="0 0 0" size="100 100 0.001" quat="1 0 0 0" material="matplane" condim="3" conaffinity="15" />
    <camera name="fixed" pos="0 -3.0 0.499" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 0.499" xyaxes="1 0 0 0 0 1" />
    
    <body name="root" pos="0 0 0" quat="1 0 0 0">
      <site name="imu" size="0.01" pos="0 0 0" />
      
      <!-- Base Link Geometries -->
      <geom type="mesh" mesh="base_link_1" pos="0 0 0.173" contype="1" conaffinity="1" />
      <geom type="mesh" mesh="base_link_2" pos="0 0 0.051" contype="1" conaffinity="1" />
      <geom type="mesh" mesh="base_link_3" pos="0 0 0.151" contype="1" conaffinity="1" />

      <body name="link_1_2" pos="0 0 0.212">
        <joint name="motor 1" pos="0 0 0" axis="0 0 1" range="-2.95903 2.95903" />
        <geom type="mesh" mesh="link_1_2_0" pos="0 0 0.0555" contype="1" conaffinity="1" />
        <geom type="mesh" mesh="link_1_2_1" pos="0 0.05 0.1485" quat="0.707105 -0.707108 0 0" contype="1" conaffinity="1" />

        <body name="link_2_3" pos="0 0 0.1505" quat="1 0 -5e-07 0">
          <joint name="motor 2" pos="0 0 0" axis="0 1 0" range="-1.91148 1.91148" />
          <geom type="mesh" mesh="link_2_3_1" pos="0 -0.05 0.005" quat="0.707105 -0.707108 0 0" contype="1" conaffinity="1" />
          <geom type="mesh" mesh="link_2_3_2" pos="0 0 0.115" contype="1" conaffinity="1" />

          <body name="link_3_4" pos="0 0 0.29" quat="1 0 -5e-07 0">
            <joint name="motor 3" pos="0 0 0" axis="0 1 0" range="-1.99927 1.99927" />
            <geom type="mesh" mesh="link_3_4_0" pos="0 0.055 -0.0005" quat="0.707105 -0.707108 0 0" contype="1" conaffinity="1" />
            <geom type="mesh" mesh="link_3_4_1" pos="0 0 0.1225" contype="1" conaffinity="1" />

            <body name="link_4_5" pos="0 0 0.164">
              <joint name="motor 4" pos="0 0 0" axis="0 0 1" range="-2.95153 2.95153" />
              <geom type="mesh" mesh="link_4_5_1" pos="0 0 0.049" contype="1" conaffinity="1" />
              <geom type="mesh" mesh="link_4_5_2" pos="0 0.05 0.142" quat="0.707105 -0.707108 0 0" contype="1" conaffinity="1" />

              <body name="link_5_6" pos="0 0 0.1455">
                <joint name="motor 5" pos="0 0 0" axis="0 1 0" range="-1.9977 1.9977" />
                <geom type="mesh" mesh="link_5_6_0" pos="0 -0.05 -0.0055" quat="0.707105 -0.707108 0 0" contype="1" conaffinity="1" />
                <geom type="mesh" mesh="link_5_6_1" pos="0 0 0.1045" contype="1" conaffinity="1" />

                <body name="right_hand" pos="0 0 0.129">
                  <site name="ee_site" pos="0 0 0.1565" size="0.01" />
                  <joint name="motor 6" pos="0 0 0" axis="0 0 1" range="-2.95833 2.95833" />
                  <geom type="mesh" mesh="link_6_top_0" pos="0 0 0.02775" contype="1" conaffinity="1" />

                  <body name="left finger" pos="0 0 0.1565" quat="1.30733e-06 2.26432e-07 0.170661 0.98533">
                    <joint name="gripper::left" pos="0 0 0" axis="-1 -3e-06 0" range="0 1.0472" />
                    <geom type="mesh" mesh="finger" pos="0 0.043733 0.044271" quat="0.989651 -0.143495 0 0" contype="1" conaffinity="1" />
                  </body>

                  <body name="right finger" pos="0 0 0.1565" quat="0.98533 0.170661 0 0">
                    <joint name="gripper::right" pos="0 0 0" axis="-1 0 0" range="0 1.0472" />
                    <geom type="mesh" mesh="finger" pos="0 0.043733 0.044271" quat="0.989651 -0.143495 0 0" contype="1" conaffinity="1" />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor 1" joint="motor 1" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="motor 2" joint="motor 2" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="motor 3" joint="motor 3" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="motor 4" joint="motor 4" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="motor 5" joint="motor 5" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="motor 6" joint="motor 6" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="gripper::left" joint="gripper::left" ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <motor name="gripper::right" joint="gripper::right" ctrllimited="true" ctrlrange="-1 1" gear="1" />
  </actuator>

  <sensor>
    <actuatorpos name="motor 1_p" actuator="motor 1" />
    <actuatorvel name="motor 1_v" actuator="motor 1" />
    <actuatorfrc name="motor 1_f" actuator="motor 1" noise="0.001" />
    <actuatorpos name="motor 2_p" actuator="motor 2" />
    <actuatorvel name="motor 2_v" actuator="motor 2" />
    <actuatorfrc name="motor 2_f" actuator="motor 2" noise="0.001" />
    <actuatorpos name="motor 3_p" actuator="motor 3" />
    <actuatorvel name="motor 3_v" actuator="motor 3" />
    <actuatorfrc name="motor 3_f" actuator="motor 3" noise="0.001" />
    <actuatorpos name="motor 4_p" actuator="motor 4" />
    <actuatorvel name="motor 4_v" actuator="motor 4" />
    <actuatorfrc name="motor 4_f" actuator="motor 4" noise="0.001" />
    <actuatorpos name="motor 5_p" actuator="motor 5" />
    <actuatorvel name="motor 5_v" actuator="motor 5" />
    <actuatorfrc name="motor 5_f" actuator="motor 5" noise="0.001" />
    <actuatorpos name="motor 6_p" actuator="motor 6" />
    <actuatorvel name="motor 6_v" actuator="motor 6" />
    <actuatorfrc name="motor 6_f" actuator="motor 6" noise="0.001" />
    <actuatorpos name="gripper::left_p" actuator="gripper::left" />
    <actuatorvel name="gripper::left_v" actuator="gripper::left" />
    <actuatorfrc name="gripper::left_f" actuator="gripper::left" noise="0.001" />
    <actuatorpos name="gripper::right_p" actuator="gripper::right" />
    <actuatorvel name="gripper::right_v" actuator="gripper::right" />
    <actuatorfrc name="gripper::right_f" actuator="gripper::right" noise="0.001" />
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
  </sensor>
</mujoco>